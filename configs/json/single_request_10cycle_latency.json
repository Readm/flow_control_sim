{
  "meta": {
    "name": "single_request_10cycle_latency",
    "description": "Single request test with deterministic 10-cycle latency"
  },
  "defaults": {
    "total_cycles": 60,
    "slave_process_rate": 1,
    "bandwidth_limit": 1,
    "slave_weights": [1],
    "master_relay_latency": 10,
    "relay_master_latency": 10,
    "relay_slave_latency": 10,
    "slave_relay_latency": 10,
    "visual_mode": "web",
    "headless": false
  },
  "nodes": [
    {"id": "rn0", "label": "Request 0", "capabilities": ["requester"]},
    {"id": "hn0", "label": "Home", "capabilities": ["home_directory"]},
    {"id": "sn0", "label": "Slave 0", "capabilities": ["slave_target"], "params": {"weight": 1}}
  ],
  "links": [
    {"from": "rn0", "to": "hn0", "latency": 10, "bandwidth": 1, "bidirectional": true},
    {"from": "hn0", "to": "sn0", "latency": 10, "bandwidth": 1, "bidirectional": true}
  ],
  "schedules": [
    {
      "tick": 0,
      "source": "rn0",
      "transactions": [
        {"type": "ReadNoSnp", "target": "sn0"}
      ]
    }
  ]
}

