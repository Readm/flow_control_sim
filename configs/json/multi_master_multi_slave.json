{
  "meta": {
    "name": "multi_master_multi_slave",
    "description": "Multi-Master Multi-Slave Network (3 Masters, 2 Slaves, 1 Home Node)"
  },
  "defaults": {
    "total_cycles": 1000,
    "request_rate": 0.8,
    "slave_process_rate": 1,
    "bandwidth_limit": 1,
    "slave_weights": [1, 1],
    "master_relay_latency": 2,
    "relay_master_latency": 2,
    "relay_slave_latency": 1,
    "slave_relay_latency": 1,
    "visual_mode": "web",
    "headless": false
  },
  "nodes": [
    {"id": "rn0", "label": "Request 0", "capabilities": ["requester"]},
    {"id": "rn1", "label": "Request 1", "capabilities": ["requester"]},
    {"id": "rn2", "label": "Request 2", "capabilities": ["requester"]},
    {"id": "hn0", "label": "Home", "capabilities": ["home_directory"]},
    {"id": "sn0", "label": "Slave 0", "capabilities": ["slave_target"], "params": {"weight": 1}},
    {"id": "sn1", "label": "Slave 1", "capabilities": ["slave_target"], "params": {"weight": 1}}
  ],
  "links": [
    {"from": "rn0", "to": "hn0", "latency": 2, "bandwidth": 1, "bidirectional": true},
    {"from": "rn1", "to": "hn0", "latency": 2, "bandwidth": 1, "bidirectional": true},
    {"from": "rn2", "to": "hn0", "latency": 2, "bandwidth": 1, "bidirectional": true},
    {"from": "hn0", "to": "sn0", "latency": 1, "bandwidth": 1, "bidirectional": true},
    {"from": "hn0", "to": "sn1", "latency": 1, "bandwidth": 1, "bidirectional": true}
  ]
}

