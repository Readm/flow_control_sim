{
  "meta": {
    "name": "readonce_mesi_snoop",
    "description": "ReadOnce MESI Snoop Test: RN0 reads first, RN1 later triggering snoop"
  },
  "defaults": {
    "total_cycles": 150,
    "slave_process_rate": 1,
    "bandwidth_limit": 1,
    "slave_weights": [1],
    "master_relay_latency": 2,
    "relay_master_latency": 2,
    "relay_slave_latency": 1,
    "slave_relay_latency": 1,
    "visual_mode": "web",
    "headless": true
  },
  "nodes": [
    {"id": "rn0", "label": "Request 0", "capabilities": ["requester", "cache:L1"]},
    {"id": "rn1", "label": "Request 1", "capabilities": ["requester", "cache:L1"]},
    {"id": "hn0", "label": "Home", "capabilities": ["home_directory", "directory"]},
    {"id": "sn0", "label": "Slave 0", "capabilities": ["slave_target"], "params": {"weight": 1}}
  ],
  "links": [
    {"from": "rn0", "to": "hn0", "latency": 2, "bandwidth": 1, "bidirectional": true},
    {"from": "rn1", "to": "hn0", "latency": 2, "bandwidth": 1, "bidirectional": true},
    {"from": "hn0", "to": "sn0", "latency": 1, "bandwidth": 1, "bidirectional": true}
  ],
  "schedules": [
    {
      "tick": 0,
      "source": "rn0",
      "transactions": [
        {"type": "ReadOnce", "target": "sn0", "address": "0x1000"}
      ]
    },
    {
      "tick": 30,
      "source": "rn1",
      "transactions": [
        {"type": "ReadOnce", "target": "sn0", "address": "0x1000"}
      ]
    }
  ]
}

